DATABASE_URL="file:./db/custom.db"
# Set to 1 only when the app is deployed behind a trusted reverse proxy
# that owns x-forwarded-for / x-real-ip. Default 0 prevents client spoofing.
TRUSTED_PROXY_HEADERS=0

MISTRAL_API_KEY=
MISTRAL_OCR_API_URL="https://api.mistral.ai/v1/ocr"
MISTRAL_MODELS="mistral-ocr-latest,mistral-ocr,pixtral-12b"
OLLAMA_HOST=127.0.0.1:11434
# For Docker, set host.docker.internal to reach Ollama on the host:
# OLLAMA_HOST=host.docker.internal:11434
# If needed, add one or more fallback hosts (host gateway candidates for Docker):
# Optional comma-separated fallback hosts for containerized environments:
# OLLAMA_HOST_FALLBACKS="host.docker.internal:11434,172.17.0.1:11434,host-gateway:11434"
# Optional comma-separated allowlist for Ollama hosts.
# OLLAMA_ALLOWED_HOSTS="localhost,127.0.0.1,host.docker.internal"
# Optional comma-separated allowlist for Mistral hosts.
# MISTRAL_ALLOWED_HOSTS="api.mistral.ai,.mistral.ai"
# Optional: Linux Docker host-network mode for Ollama bound to 127.0.0.1.
# Set at compose parse time (shell/.env file), and keep APP_NETWORK_MODE=host at runtime:
# APP_NETWORK_MODE=host
# Compose interpolation is read from `.env` by default (or `--env-file`), while runtime env for
# containers comes from docker.env + `.env` entries passed through compose.
APP_NETWORK_MODE=host
# In `.env`: APP_NETWORK_MODE=host
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
COOKIE_SECURE=false
