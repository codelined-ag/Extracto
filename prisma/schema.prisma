// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OcrJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model AuthUser {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  passwordChangedAt     DateTime       @default(now())
  totpSecret            String?
  totpEnabled           Boolean        @default(false)
  totpRecoveryCodesHash Json?
  pendingEmail          String?
  emailChangeTokenHash  String?
  emailChangeExpiresAt  DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  e2ePublicKeyPem        String?
  e2ePublicKeyFingerprint String?
  e2ePublicKeyRegisteredAt DateTime?
  name                  String?
  jobs               OcrJob[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  outputPresets      OutputPreset[]
  ocrSettings        OcrSetting[]
  jobTemplates       OcrJobTemplate[]
  watchedS3Sources   WatchedS3Source[]
  pushSubscriptions  PushSubscription[]
  tags               Tag[]
  savedSearches      SavedSearch[]
  integrationConnections IntegrationConnection[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model IntegrationConnection {
  id            String   @id @default(cuid())
  userId        String
  user          AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  accountLabel  String
  encryptedTokens String
  clientIdLast4 String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model ApiKey {
  id                  String    @id @default(cuid())
  userId              String
  user                AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  prefix              String
  keyHash             String    @unique
  scopes              String    @default("[\"*\"]")
  rateLimitPerMinute  Int?
  totalRequests       Int       @default(0)
  requestsThisMonth   Int       @default(0)
  monthlyResetAt      DateTime?
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([keyHash])
}

model Webhook {
  id         String    @id @default(cuid())
  userId     String
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  events     String    @default("[\"job.completed\",\"job.failed\"]")
  active     Boolean   @default(true)
  lastFiredAt DateTime?
  failureCount Int      @default(0)
  createdAt  DateTime  @default(now())
  deliveries WebhookDelivery[]

  @@index([userId, createdAt(sort: Desc)])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  url          String
  statusCode   Int?
  ok           Boolean  @default(false)
  durationMs   Int?
  errorMessage String?
  attemptedAt  DateTime @default(now())

  @@index([webhookId, attemptedAt(sort: Desc)])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model OutputPreset {
  id           String   @id @default(cuid())
  userId       String
  user         AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  instruction  String
  outputFormat String   @default("markdown")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model OcrSetting {
  id                     String       @id @default(cuid())
  // Per-user settings row. The (userId, key) tuple is unique so each user
  // owns exactly one row per key (currently only "global" is in use).
  // Pre-existing rows with userId=NULL are migration-orphaned; the route
  // never reads them.
  userId                 String?
  user                   AuthUser?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key                    String
  language               String       @default("auto")
  tableDetection         Boolean      @default(true)
  handwritingRecognition Boolean      @default(false)
  preserveFormatting     Boolean      @default(true)
  customPrompt           String       @default("")
  quality                Int          @default(80)
  preferTextLayer        Boolean      @default(true)
  documentPreset         String       @default("generic")
  pageConcurrency        Int          @default(0)
  autoRetryMaxAttempts   Int          @default(1)
  piiRedaction           Boolean      @default(false)
  jobs                   OcrJob[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model OcrJob {
  id                     String       @id @default(cuid())
  userId                 String?
  user                   AuthUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId               String?
  status                 OcrJobStatus @default(QUEUED)
  priority               Int          @default(0)
  fileName               String
  sourcePreview          String?
  model                  String
  language               String
  tableDetection         Boolean
  handwritingRecognition Boolean
  preserveFormatting     Boolean
  customPrompt           String
  quality                Int
  settingsId             String?
  settings               OcrSetting?  @relation(fields: [settingsId], references: [id], onDelete: SetNull)
  settingsSnapshot       Json
  prompt                 String
  extractedText          String?
  extractedTextLocation  String?
  result                 Json?
  resultLocation         String?
  metadata               Json?
  errorMessage           String?
  stopRequestedAt        DateTime?
  batchId                String?
  comparisonId           String?
  attemptCount           Int          @default(1)
  maxAttempts            Int          @default(1)
  nextRetryAt            DateTime?
  userEdited             Boolean      @default(false)
  editedAt               DateTime?
  startedAt              DateTime     @default(now())
  completedAt            DateTime?
  processingMs           Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  jobTags                JobTag[]

  @@index([status, priority(sort: Desc), createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([settingsId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([batchId])
  @@index([comparisonId])
  @@index([status, nextRetryAt])
}

model OcrJobTemplate {
  id              String   @id @default(cuid())
  userId          String
  user            AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  model           String
  provider        String
  preset          String   @default("generic")
  language        String   @default("auto")
  customPrompt    String   @default("")
  postProcessing  Json?
  autoExports     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
}

model WatchedS3Source {
  id                    String              @id @default(cuid())
  userId                String
  user                  AuthUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  prefix                String              @default("")
  intervalSeconds       Int                 @default(60)
  active                Boolean             @default(true)
  model                 String
  templateId            String?
  autoKbExport          Boolean             @default(false)
  autoS3Export          Boolean             @default(false)
  lastPolledAt          DateTime?
  lastError             String?
  consecutiveFailures   Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  objects               WatchedS3Object[]

  @@unique([userId, name])
  @@index([userId, active])
}

model WatchedS3Object {
  id           String          @id @default(cuid())
  sourceId     String
  source       WatchedS3Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  bucket       String
  key          String
  etag         String?
  jobId        String?
  ingestedAt   DateTime        @default(now())

  @@unique([sourceId, key])
  @@index([sourceId, ingestedAt(sort: Desc)])
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  failureCount Int     @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("slate")
  jobTags   JobTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
}

model JobTag {
  jobId     String
  tagId     String
  job       OcrJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, tagId])
  @@index([tagId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
}
