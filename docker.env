NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=file:/app/data/custom.db
MIGRATE_ON_START=1
APP_NETWORK_MODE=host
# Required: set a strong random secret (min 32 chars) before starting the app.
# AUTH_SECRET=replace-with-a-long-random-secret
# Set this to true when running behind HTTPS reverse proxy
COOKIE_SECURE=false
# Works with host-mode docker networking when host Ollama uses default loopback bind.
OLLAMA_HOST=http://127.0.0.1:11434
# Optional comma-separated allowed hosts for Ollama endpoints.
# OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# Optional comma-separated allowed hosts for Mistral endpoints.
# MISTRAL_ALLOWED_HOSTS=api.mistral.ai,.mistral.ai
# Optional comma-separated allowed hosts for OpenRouter endpoints.
# OPENROUTER_ALLOWED_HOSTS=openrouter.ai,.openrouter.ai
# Optional override for the OpenRouter API base URL (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Optional fallback API key for OpenRouter when no per-user key is set.
# OPENROUTER_API_KEY=
# Optional referer/title sent on OpenRouter requests (used for analytics).
# OPENROUTER_REFERER=https://your-site.example
# OPENROUTER_TITLE=Extracto
# Optional comma-separated fallback model list shown when discovery fails.
# OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o,google/gemini-2.0-flash-001
# Optional comma-separated allowed hosts for OpenAI-compatible endpoints.
# Defaults cover api.openai.com only — extend for self-hosted vLLM/LocalAI/Groq/etc.
# OPENAI_COMPAT_ALLOWED_HOSTS=api.openai.com,.openai.com,my-vllm.example
# Optional override for the OpenAI-compatible API base URL placeholder.
# OPENAI_COMPAT_API_URL=https://api.openai.com/v1
# Optional fallback API key when no per-user key is set.
# OPENAI_COMPAT_API_KEY=
# Optional comma-separated fallback model list when discovery fails.
# OPENAI_COMPAT_MODELS=gpt-4o,gpt-4o-mini
# Optional comma-separated additional Ollama host:port fallbacks tried in order
# when the primary endpoint fails (useful in bridge mode with custom networks).
# OLLAMA_HOST_FALLBACKS=host.docker.internal:11434,172.17.0.1:11434
# Optional bridge-mode setup (requires host Ollama bound to 0.0.0.0):
# APP_NETWORK_MODE=bridge
# OLLAMA_HOST=http://host.docker.internal:11434

# Knowledge-base export. Defaults to enabled. Set to 0 to gate
# POST /api/kb/export (browser UI) and POST /api/v1/export/kb
# (headless bearer-auth) when you want operators to opt in deliberately.
KB_EXPORT_ENABLED=1

# Account creation. Set to 0 to disable POST /api/auth/signup so only
# operator-provisioned accounts can log in. The login endpoint and the
# /auth UI keep working; only signup is gated.
ALLOW_SIGNUP=1

# Comma-separated allowlist for outbound webhook URLs. Hosts not on this
# list are rejected at registration time. RFC1918, link-local, loopback,
# and other private ranges are rejected unconditionally even if listed.
# WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,api.example.com
