NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=file:/app/data/custom.db
MIGRATE_ON_START=1
APP_NETWORK_MODE=host
# Set a strong random secret in production
AUTH_SECRET=change-me-in-production
# Set this to true when running behind HTTPS reverse proxy
COOKIE_SECURE=false
# Works with host-mode docker networking when host Ollama uses default loopback bind.
OLLAMA_HOST=http://127.0.0.1:11434
OBSIDIAN_EXPORT_BASE_DIR=/host-vaults
# Host folder where Obsidian vaults will be created by PDF -> Obsidian mode
OBSIDIAN_EXPORT_HOST_ROOT=./obsidian-vaults
# Optional bridge-mode setup (requires host Ollama bound to 0.0.0.0):
# APP_NETWORK_MODE=bridge
# OLLAMA_HOST=http://host.docker.internal:11434
